# MeetMind - AI Meeting Summarizer Environment Variables

# OpenAI API Key for Whisper (Speech-to-Text) and GPT (Summarization & Extraction)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default LLM Model (default: gpt-4o-mini, supports gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional: Maximum upload size in MB (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Optional: SQLite Database path (default: meetmind.db)
DB_PATH=meetmind.db
